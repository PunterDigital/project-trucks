{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProjectTrucks",
  "version": "0.1.0",
  "identifier": "co.shaypunter.projecttrucks",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ProjectTrucks",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "shortDescription": "Local Euro Truck Simulator 2 delivery tracker",
    "category": "Utility"
  }
}
