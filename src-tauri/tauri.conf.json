{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProjectTrucks",
  "version": "0.4.0",
  "identifier": "co.shaypunter.projecttrucks",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "ProjectTrucks",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../assets/telemetry-plugin/win_x64/ets2-telemetry-server.dll": "telemetry-plugin/ets2-telemetry-server.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Local Euro Truck Simulator 2 delivery tracker",
    "longDescription": "ProjectTrucks logs every Euro Truck Simulator 2 delivery, session and kilometre to a private SQLite database on your own machine, with a dashboard, per-truck stats, CSV export and backups. Auto-capture reads the game through the bundled telemetry plugin.",
    "publisher": "PunterDigital",
    "copyright": "Copyright (c) 2026 Shay Punter. MIT licence.",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
